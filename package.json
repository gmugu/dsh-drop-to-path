{
  "name": "dsh-drop-to-path",
  "description": "Turn dropped or pasted files into workspace file paths for DeepSeek Harness. | 中文：把拖入或粘贴的文件转成工作区文件路径，交给纯文本模型。",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/clipboard-image.ps1",
    "lib/clipboard-state.ps1",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "README.zh.md",
    "ADAPTING.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "attachment",
    "vision"
  ],
  "homepage": "https://github.com/gmugu/dsh-drop-to-path#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmugu/dsh-drop-to-path.git"
  },
  "bugs": {
    "url": "https://github.com/gmugu/dsh-drop-to-path/issues"
  },
  "author": "gmugu"
}
